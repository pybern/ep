# Copy to .env.local. Never commit real credentials.
# Generate CONFIG_ADMIN_TOKEN with: openssl rand -hex 32
CONFIG_ADMIN_TOKEN=""
AI_GATEWAY_API_KEY=""

# Leave this entire group blank to use saved API settings.
# When enabled, LLM_BASE_URL and LLM_MODEL are required.
LLM_BASE_URL="https://ai-gateway.vercel.sh/v1"
LLM_MODEL="alibaba/qwen3.6-27b"
LLM_API_KEY=""
LLM_REASONING_EFFORT=""
LLM_PLANNING_OUTPUT_TOKENS=4096
LLM_CHART_OUTPUT_TOKENS=4096
LLM_EXPLANATION_OUTPUT_TOKENS=4096

# Leave this entire group blank to use the saved database connection.
# When enabled, DB_HOST, DB_DATABASE and DB_USERNAME are required.
# Blank DB_PORT defaults to 5432; blank DB_SSL defaults to true.
DB_HOST=""
DB_PORT=""
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""
DB_SSL=""
DB_CA_CERTIFICATE=""
