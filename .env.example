# Copy to .env.local. Never commit real credentials.
# Generate CONFIG_ADMIN_TOKEN with: openssl rand -hex 32
CONFIG_ADMIN_TOKEN=""
AI_GATEWAY_API_KEY=""

# Provider defaults when no PostgreSQL provider row exists. Leave blank for legacy file settings before database initialization.
# When enabled, LLM_BASE_URL and LLM_MODEL are required.
LLM_BASE_URL="https://ai-gateway.vercel.sh/v1"
LLM_MODEL="alibaba/qwen3.6-27b"
LLM_API_KEY=""
LLM_REASONING_EFFORT=""
# Set false for providers without GET /models or reasoning metadata.
LLM_USE_MODEL_CATALOG=""
# Set true to honor HTTP_PROXY, HTTPS_PROXY and NO_PROXY. Default: connect directly.
LLM_TRUST_ENV=""
# Blank LLM_VERIFY_SSL defaults to false. Custom CA requires explicit verification.
LLM_VERIFY_SSL=""
LLM_CA_CERTIFICATE=""
LLM_PLANNING_OUTPUT_TOKENS=4096
LLM_CHART_OUTPUT_TOKENS=4096
LLM_EXPLANATION_OUTPUT_TOKENS=4096

# Strict or unusual providers (all optional; see README "Strict providers").
# LLM_STRUCTURED_OUTPUT: json_schema (default), json_object or prompt.
LLM_STRUCTURED_OUTPUT=""
# Set false for gateways that cannot stream.
LLM_STREAMING=""
# max_tokens (default) or max_completion_tokens.
LLM_MAX_TOKENS_PARAM=""
# Comma-separated request fields to remove, e.g. temperature,top_p,reasoning_effort.
LLM_DROP_PARAMS=""
# JSON objects: LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
LLM_EXTRA_BODY=""
# Header values are credentials: LLM_REQUEST_HEADERS='{"api-key":"..."}'
LLM_REQUEST_HEADERS=""

# Leave this entire group blank to use the saved database connection.
# When enabled, DB_HOST, DB_DATABASE and DB_USERNAME are required.
# Blank DB_PORT defaults to 5432; blank DB_SSL defaults to true.
DB_HOST=""
DB_PORT=""
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""
DB_SSL=""
DB_CA_CERTIFICATE=""
